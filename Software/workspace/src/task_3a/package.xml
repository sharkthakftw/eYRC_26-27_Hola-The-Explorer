<package format="3">
  <name>task_3a</name>
  <version>0.0.1</version>
  <description>Task 3A: one holonomic robot finds a payload in the overhead
    camera, docks on it, attaches to it through the /r2/attach_payload service,
    carries it onto the hexagon's centre around randomly laid-out obstacles, lets
    it go and drives back to its start circle</description>
  <maintainer email="sahil.shinde@e-yantra.org">sahil</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rclcpp</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <!-- the payload services: hb_description/srv/AttachPayload and DetachPayload -->
  <exec_depend>hb_description</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
